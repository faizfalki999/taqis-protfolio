rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // TAQI HAIDER PORTFOLIO — FIRESTORE SECURITY RULES
    // =========================================================================

    // Projects Collection:
    // - Public Read: Anyone visiting your portfolio can view case studies & assets
    // - Authenticated Write: Only logged-in administrators (via Firebase Auth) can add, edit, or delete
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default Fallback:
    // Deny read/write access to any other unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
